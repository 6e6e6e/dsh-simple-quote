{
  "name": "dsh-simple-quote",
  "version": "0.0.6",
  "private": true,
  "description": "Quote selected conversation text into the composer with one click.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "lib",
    "scripts",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "release": "node scripts/release.mjs",
    "test": "node --test test/quote-text.test.mjs test/selection-markdown.test.mjs test/bundle.test.mjs test/edge-cases.test.mjs",
    "prepack": "node scripts/build-client.mjs",
    "pretest": "node scripts/build-client.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
